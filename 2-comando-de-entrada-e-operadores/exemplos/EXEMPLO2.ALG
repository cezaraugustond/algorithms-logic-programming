algoritmo "Aula3Pratica1"
var
      Valor1, Valor2, Resultado: Inteiro
inicio
      Escreva("Digite o primeiro número: ")
      Leia(Valor1)
      Escreva("Digite o segundo número: ")
      Leia(Valor2)
      Resultado <- Valor1 + Valor2
      Escreva("A soma entre", Valor1, " e", Valor2, " é", Resultado)
fimalgoritmo