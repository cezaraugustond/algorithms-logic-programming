algoritmo "aula3pratica2"
var
   Valor1, Valor2: Inteiro
   Media: Real
inicio
      Escreva("Digite o primeiro número: ")
      Leia(Valor1)
      Escreva("Digite o segundo número: ")
      Leia(Valor2)
      Media <- (Valor1 + Valor2) / 2
      Escreva("A média entre ", Valor1, " e ", Valor2, " é igual a ", Media)

fimalgoritmo