algoritmo "Aula12Pratica4"
var
   N1, N2: Inteiro
Procedimento Rotina(A, B: Inteiro)
var
   X, Y: Inteiro
Inicio
      X <- A
      Y <- B
      Escreva(N1, N2, A, B , X, Y)
FimProcedimento
inicio
      N1 <- 5
      N2 <- 3
      Rotina(N1, N2)
      //Escreva(N1, N2, A, B , X, Y)
      //As variáveis A, B, X, Y são locais, por isso não são executadas
fimalgoritmo