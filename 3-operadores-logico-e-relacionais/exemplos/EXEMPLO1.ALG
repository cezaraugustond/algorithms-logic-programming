algoritmo "Aula4Pratica1"
var
   Valor1, Valor2: Inteiro
   Maior: Logico
inicio
      Escreva("Digite o primiero número: ")
      Leia(Valor1)
      Escreva("Digite o segundo número: ")
      Leia(Valor2)
      Maior <- Valor1 > Valor2
      Escreva("O número ", Valor1, " é maior que o número ", Valor2, "?", Maior)

fimalgoritmo