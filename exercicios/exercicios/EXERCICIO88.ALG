algoritmo "Exercicio88"
var
Procedimento Gerador(x: Caractere; y: Inteiro)
var
   cont: Inteiro
Inicio
      EscrevaL("+-------=======------+")
      Para cont <- 1 ate y faca
           EscrevaL(x)
      FimPara
      EscrevaL("+-------=======------+")
FimProcedimento
inicio
      Gerador("Aprendendo Portugol", 4)
fimalgoritmo