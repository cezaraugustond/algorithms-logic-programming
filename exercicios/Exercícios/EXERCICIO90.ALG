algoritmo "Exercicio90"
var
   valor1, valor2: Inteiro
Procedimento Somador(x, y: Inteiro)
var
   z: Inteiro
Inicio
      z <- x + y
      Escreva("Soma:", x, " +", y, " =", z)
FimProcedimento
inicio
      Escreva("Primeiro valor: ")
      Leia(valor1)
      Escreva("Segundo valor: ")
      Leia(valor2)
      Somador(valor1, valor2)
fimalgoritmo