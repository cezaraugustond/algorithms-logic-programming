algoritmo "Exercicio48"
var
   cont, valor, soma: Inteiro
inicio
      cont <- 1
      soma <- 0
      Enquanto (cont <= 7) faca
               Escreva("Valor: ")
               Leia(valor)
               soma <- soma + valor
               cont <- cont + 1
      FimEnquanto
      Escreva("Somatório = ", soma)
fimalgoritmo