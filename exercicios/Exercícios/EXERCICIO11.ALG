algoritmo "Exercicio11"
var
   valorA, valorB, valorC: Inteiro
   delta: Real
inicio
      Escreva("A = ")
      Leia(valorA)
      Escreva("B = ")
      Leia(valorB)
      Escreva("C = ")
      Leia(valorC)
      delta <- valorB*valorB - 4 * valorA * valorC
      EscrevaL("Delta = ", delta)
fimalgoritmo